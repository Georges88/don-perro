# Shopify Storefront API: used for public catalog reads.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="your_storefront_access_token"
SHOPIFY_API_VERSION="2026-04"

# Shopify Admin API: used server-side only to create Customer records.
# Requires write_customers scope. Never expose this token to client components.
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_your_admin_access_token"

# Shopify Customer Account API: used for hosted customer login and customer-scoped account data.
# Configure these from the Headless or Hydrogen sales channel Customer Account API settings.
SHOPIFY_CUSTOMER_ACCOUNT_DOMAIN="your-store.myshopify.com"
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID="your_customer_account_client_id"
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=""
SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI="https://your-public-domain.com/api/auth/callback"
